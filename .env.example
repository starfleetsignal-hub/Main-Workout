# Copy to .env, or let `npm run license:keygen` write it for you.
#
# The Ed25519 public key that license keys are verified against. Every build
# you ship must carry YOUR key: a build without it cannot be activated at all,
# and a build with someone else's key will not accept keys you issue.
EXPO_PUBLIC_LICENSE_PUBLIC_KEY=

# Where the "Buy a license" button sends people. Leave blank to hide the button.
EXPO_PUBLIC_PURCHASE_URL=

# Hosted privacy policy / terms of use — required by the app stores before
# submission. See legal/PRIVACY.md and legal/TERMS.md for templates to fill
# in and host, then link them here. Leave blank to hide the links.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=

# --- Server-side only (never prefix these with EXPO_PUBLIC_) -----------------
# The signing key lives in license-private.key by default. The fulfillment
# server can read it from the environment instead:
# LICENSE_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n…"
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# LICENSE_PLAN=lifetime

# --- Headless runner only ---------------------------------------------------
# ALPACA_KEY_ID=
# ALPACA_SECRET_KEY=
# ALPACA_MODE=paper
# ALPACA_FEED=iex
# TRADERUNNER_LICENSE=TR1....
